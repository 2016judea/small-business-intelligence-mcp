# Copy to .env (gitignored) and fill in. Load before wrangler CLI commands:
#   export $(grep -v ^# .env | xargs)

# Cloudflare account this Worker deploys to (Aidanjude2016@gmail.com's Account).
CLOUDFLARE_ACCOUNT_ID=

# Scoped Cloudflare API token with Workers Scripts + Workers KV Storage edit
# permissions. Create/rotate at https://dash.cloudflare.com/<account_id>/api-tokens
CLOUDFLARE_API_TOKEN=
