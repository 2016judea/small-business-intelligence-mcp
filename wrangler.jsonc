{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbi-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  // Explicit, because the defaults were not what they looked like: with a bare
  // `enabled: true`, Workers Logs held ~200 request events a day against the
  // ~2,000 requests GraphQL counted (2026-09-04) — sampled, and every count read
  // off the logs was a tenth of the truth. Full rate; the free tier is 200k
  // events a day and we run at ~4k.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  // Usage ledger for the (currently dormant) metered policy — free KV tier.
  "kv_namespaces": [
    {
      "binding": "USAGE_LEDGER",
      "id": "8d17fe9122bd4e1090f7b82780c644ae"
    }
  ],
  "vars": {
    // "allow_all" (shipped default) never denies. "metered" enforces
    // POLICY_METERED_DAILY_LIMIT per identity/day — implemented, not active.
    "POLICY_MODE": "allow_all",
    "POLICY_METERED_DAILY_LIMIT": "50",
    "POLICY_UPGRADE_URL": "https://brickandmortar.dev"
  }
}
